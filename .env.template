# Pokémon Collection App - Environment Variables
# REQUIRED. Copy this file to .env at the project root and fill in real values:
#   cp .env.template .env
#
# The backend fails to start without the backend vars below.
# The frontend reads VITE_API_BASE_URL (also set in frontend/.env).

# ----- Backend (Spring Boot) -----
# JWT signing secret. Use a strong, opaque base64 value (>=32 chars).
APP_JWT_SECRET=ZGV2c2VjcmV0Y2hhbmdlbWVwbGVhc2UzMmNoYXJzbWluaW11bQ

# Comma-separated list of allowed CORS origins for the frontend.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----- Frontend (Vite) -----
# Base URL for backend API calls from the browser.
# Also set this in frontend/.env (see frontend/.env.example).
VITE_API_BASE_URL=http://localhost:8080/api
